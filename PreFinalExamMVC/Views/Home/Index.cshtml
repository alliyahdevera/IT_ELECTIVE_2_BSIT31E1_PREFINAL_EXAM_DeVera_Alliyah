@{
    ViewData["Title"] = "Prefinal Exam";
}

<div class="text-center mb-5">
    <h1 class="fw-bold">PREFINAL EXAMINATION</h1>
</div>

<div class="row g-4">
    <div class="col-md-3">
        <div class="topic-card c-purple">
            <div class="topic-icon"><i class="bi bi-database"></i></div>
            <h5 class="fw-bold">Relational Data Modeling </h5>
            <p class="text-secondary" style="font-size: 13px;">Model Binding and Controller Actions</p>
            <a asp-controller="Exam" asp-action="Topic1" class="btn-topic">View topic <i class="bi bi-arrow-right"></i></a>
        </div>
    </div>
    <div class="col-md-3">
        <div class="topic-card c-green">
            <div class="topic-icon"><i class="bi bi-diagram-3"></i></div>
            <h5 class="fw-bold">Conceptual Data Architecture</h5>
            <p class="text-secondary" style="font-size: 13px;">Designing ERDs; Razor Syntax and Dynamic Rendering</p>
            <a asp-controller="Exam" asp-action="Topic2" class="btn-topic">View topic <i class="bi bi-arrow-right"></i></a>
        </div>
    </div>
    <div class="col-md-3">
        <div class="topic-card c-pink">
            <div class="topic-icon"><i class="bi bi-clipboard-check"></i></div>
            <h5 class="fw-bold">Data Normalization & Structural Integrity </h5>
            <p class="text-secondary" style="font-size: 13px;">Data Validation and ModelState</p>
            <a asp-controller="Exam" asp-action="Topic3" class="btn-topic">View topic <i class="bi bi-arrow-right"></i></a>
        </div>
    </div>
    <div class="col-md-3">
        <div class="topic-card c-blue">
            <div class="topic-icon"><i class="bi bi-shield-check"></i></div>
            <h5 class="fw-bold">Introduction to Structured Query Language</h5>
            <p class="text-secondary" style="font-size: 13px;">In-Memory Data Storage and CRUD Operations</p>
            <a asp-controller="Exam" asp-action="Topic4" class="btn-topic">View topic <i class="bi bi-arrow-right"></i></a>
        </div>
    </div>
</div>